# These defaults match the local services in docker-compose.yml.
APP_NAME=CRMP Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+asyncpg://crmp:crmp@127.0.0.1:5432/crmp
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
SESSION_COOKIE_NAME=crmp_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SQL_ECHO=false
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=crmp.events



# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5199
