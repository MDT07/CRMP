# These defaults match the local services in docker-compose.yml.
APP_NAME=CRMP Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+asyncpg://crmp:crmp@127.0.0.1:5432/crmp
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=crmp_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SQL_ECHO=false
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=crmp.events

# Private-first AI defaults. Keep the model runtime on the same machine.
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Set this if LM Studio native API authentication is enabled.
LLM_API_KEY=
# LM Studio endpoint strategy: auto, native, or openai.
LM_STUDIO_API_MODE=auto
LLM_MODEL=nvidia/nemotron-3-nano-4b
LLM_MODEL_CHAT=nvidia/nemotron-3-nano-4b
LLM_MODEL_AGENT=nvidia/nemotron-3-nano-4b
LLM_MODEL_PROJECT_INTEL=nvidia/nemotron-3-nano-4b
LOCAL_AI_ONLY=true
AI_CACHE_TTL_SECONDS=900
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=30
API_KEY_RATE_LIMIT_REQUESTS_PER_MINUTE=240
API_KEY_INVALID_ATTEMPTS_PER_MINUTE=60
TELEMETRY_ENABLED=true
TELEMETRY_EXPORTER_MODE=console
TELEMETRY_SERVICE_NAME=crmp-backend
TELEMETRY_OTLP_ENDPOINT=
PROJECT_ASSISTANT_ROOT=..
PROJECT_ASSISTANT_MAX_FILES=3000

# Email OAuth Configuration (Gmail)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:5173/email/oauth/callback

# Email OAuth Configuration (Outlook)
# Get these from Azure Portal: https://portal.azure.com/
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:5173/email/oauth/callback

# OAuth Security
OAUTH_STATE_SECRET=replace-with-random-secret-for-oauth-state

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173
